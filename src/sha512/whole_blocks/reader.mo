        t := h +% K.K70 +% w70 +% g ^ (e & (f ^ g)) +% rot(e, 14) ^ rot(e, 18) ^ rot(e, 41); h := g; g := f; f := e; e := d +% t; d := c; c := b; b := a; mj0 := b ^ c; a := t +% c ^ (mj0 & mj1) +% rot(a, 28) ^ rot(a, 34) ^ rot(a, 39);
        t := h +% K.K71 +% w71 +% g ^ (e & (f ^ g)) +% rot(e, 14) ^ rot(e, 18) ^ rot(e, 41); h := g; g := f; f := e; e := d +% t; d := c; c := b; b := a; mj1 := b ^ c; a := t +% c ^ (mj1 & mj0) +% rot(a, 28) ^ rot(a, 34) ^ rot(a, 39);
        t := h +% K.K72 +% w72 +% g ^ (e & (f ^ g)) +% rot(e, 14) ^ rot(e, 18) ^ rot(e, 41); h := g; g := f; f := e; e := d +% t; d := c; c := b; b := a; mj0 := b ^ c; a := t +% c ^ (mj0 & mj1) +% rot(a, 28) ^ rot(a, 34) ^ rot(a, 39);
        t := h +% K.K73 +% w73 +% g ^ (e & (f ^ g)) +% rot(e, 14) ^ rot(e, 18) ^ rot(e, 41); h := g; g := f; f := e; e := d +% t; d := c; c := b; b := a; mj1 := b ^ c; a := t +% c ^ (mj1 & mj0) +% rot(a, 28) ^ rot(a, 34) ^ rot(a, 39);
        t := h +% K.K74 +% w74 +% g ^ (e & (f ^ g)) +% rot(e, 14) ^ rot(e, 18) ^ rot(e, 41); h := g; g := f; f := e; e := d +% t; d := c; c := b; b := a; mj0 := b ^ c; a := t +% c ^ (mj0 & mj1) +% rot(a, 28) ^ rot(a, 34) ^ rot(a, 39);
        t := h +% K.K75 +% w75 +% g ^ (e & (f ^ g)) +% rot(e, 14) ^ rot(e, 18) ^ rot(e, 41); h := g; g := f; f := e; e := d +% t; d := c; c := b; b := a; mj1 := b ^ c; a := t +% c ^ (mj1 & mj0) +% rot(a, 28) ^ rot(a, 34) ^ rot(a, 39);
        t := h +% K.K76 +% w76 +% g ^ (e & (f ^ g)) +% rot(e, 14) ^ rot(e, 18) ^ rot(e, 41); h := g; g := f; f := e; e := d +% t; d := c; c := b; b := a; mj0 := b ^ c; a := t +% c ^ (mj0 & mj1) +% rot(a, 28) ^ rot(a, 34) ^ rot(a, 39);
        t := h +% K.K77 +% w77 +% g ^ (e & (f ^ g)) +% rot(e, 14) ^ rot(e, 18) ^ rot(e, 41); h := g; g := f; f := e; e := d +% t; d := c; c := b; b := a; mj1 := b ^ c; a := t +% c ^ (mj1 & mj0) +% rot(a, 28) ^ rot(a, 34) ^ rot(a, 39);
        t := h +% K.K78 +% w78 +% g ^ (e & (f ^ g)) +% rot(e, 14) ^ rot(e, 18) ^ rot(e, 41); h := g; g := f; f := e; e := d +% t; d := c; c := b; b := a; mj0 := b ^ c; a := t +% c ^ (mj0 & mj1) +% rot(a, 28) ^ rot(a, 34) ^ rot(a, 39);
        t := h +% K.K79 +% w79 +% g ^ (e & (f ^ g)) +% rot(e, 14) ^ rot(e, 18) ^ rot(e, 41); h := g; g := f; f := e; e := d +% t; d := c; c := b; b := a; mj1 := b ^ c; a := t +% c ^ (mj1 & mj0) +% rot(a, 28) ^ rot(a, 34) ^ rot(a, 39);
      };

      // final addition
